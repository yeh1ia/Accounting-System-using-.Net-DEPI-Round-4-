@using Accounting.Data.Domain
@model IEnumerable<Accounting.Data.ViewModels.Purchases.BillListItem>

@{
    ViewData["Title"] = "Bill Approvals";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h2><i class="bi bi-check-circle-fill text-warning"></i> Bill Approvals</h2>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-check-circle" style="font-size:3rem; color:#198754;"></i>
            <h4 class="mt-3 text-success">All Caught Up!</h4>
            <p class="text-muted">There are no pending bill approvals at the moment.</p>
            <a asp-action="Index" class="btn btn-primary mt-2">Back to Bills</a>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning d-flex align-items-center mb-3">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>@Model.Count() bill(s)</strong> awaiting approval.
    </div>

    <div class="row g-3">
        @foreach (var bill in Model)
        {
            <div class="col-xl-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-bold">@bill.BillNumber</span>
                            @if (!string.IsNullOrEmpty(bill.OrderNumber))
                            {
                                <span class="text-muted ms-2">| Order: @bill.OrderNumber</span>
                            }
                        </div>
                        <span class="badge bg-secondary">@bill.Status</span>
                    </div>
                    <div class="card-body">
                        <div class="row mb-2">
                            <div class="col-6">
                                <small class="text-muted">Vendor</small>
                                <p class="mb-0 fw-semibold">@bill.ContactName</p>
                            </div>
                            <div class="col-6">
                                <small class="text-muted">Category</small>
                                <p class="mb-0">@bill.CategoryName</p>
                            </div>
                            <div class="col-6">
                                <small class="text-muted">Bill Date</small>
                                <p class="mb-0">@bill.BilledAt.ToString("dd MMM yyyy")</p>
                            </div>
                            <div class="col-6">
                                <small class="text-muted">Due Date</small>
                                <p class="mb-0 @(bill.DueAt < DateTime.Today ? "text-danger fw-bold" : "")">
                                    @bill.DueAt.ToString("dd MMM yyyy")
                                </p>
                            </div>
                        </div>
                        <div class="bg-light rounded p-3 text-end">
                            <span class="text-muted small">Amount Due</span>
                            <div class="fs-4 fw-bold text-danger">
                                @bill.CurrencySymbol@bill.AmountDue.ToString("N2")
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white no-print">
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@bill.BillId" class="btn btn-sm btn-outline-primary flex-fill">
                                <i class="bi bi-eye"></i> View
                            </a>
                            <form asp-action="ApproveBill" asp-route-id="@bill.BillId" method="post" class="flex-fill">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-success w-100">
                                    <i class="bi bi-check-circle"></i> Approve
                                </button>
                            </form>
                            <button type="button" class="btn btn-sm btn-outline-danger flex-fill"
                                    onclick="showRejectModal('@bill.BillId', '@bill.BillNumber')">
                                <i class="bi bi-x-circle"></i> Reject
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@* Rejection modal *@
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-x-circle"></i> Reject Bill</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="RejectBill">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="rejectBillId" />
                <div class="modal-body">
                    <p>Rejecting: <strong id="rejectBillNumber"></strong></p>
                    <div class="mb-3">
                        <label class="form-label">Reason (optional)</label>
                        <textarea name="reason" class="form-control" rows="3" placeholder="Enter rejection reason..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-circle"></i> Confirm Rejection
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function showRejectModal(id, billNumber) {
    document.getElementById('rejectBillId').value = id;
    document.getElementById('rejectBillNumber').textContent = billNumber;
    new bootstrap.Modal(document.getElementById('rejectModal')).show();
}
</script>

@section Scripts {
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
}