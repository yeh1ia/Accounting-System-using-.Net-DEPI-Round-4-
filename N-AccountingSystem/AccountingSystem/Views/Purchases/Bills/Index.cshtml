@using Accounting.Data.Domain

@model IEnumerable<Accounting.Data.ViewModels.Purchases.BillListItem>

@{
    ViewData["Title"] = "Bills";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var statuses = Enum.GetValues<DocumentStatus>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-file-earmark-text-fill"></i> Bills</h2>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> New Bill
        </a>
        <a asp-action="Approvals" class="btn btn-outline-warning">
            <i class="bi bi-check-circle"></i> Approvals
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted">Search</label>
                <input name="search" value="@ViewBag.Search" class="form-control"
                       placeholder="Bill #, Contact, Order #..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    @foreach (var s in statuses)
                    {
                        <option value="@s" selected="@(ViewBag.Status == s.ToString() ? "selected" : null)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Bill #</th>
                        <th>Order #</th>
                        <th>Vendor</th>
                        <th>Category</th>
                        <th>Bill Date</th>
                        <th>Due Date</th>
                        <th>Amount</th>
                        <th>Paid</th>
                        <th>Due</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted py-5">
                                <i class="bi bi-file-earmark" style="font-size:2.5rem;"></i>
                                <p class="mb-0 mt-2">No bills found.</p>
                                <a asp-action="Create" class="btn btn-sm btn-primary mt-2">Create First Bill</a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var bill in Model)
                        {
                            var isOverdue = bill.DueAt < DateTime.Today && bill.Status != DocumentStatus.Paid;
                            <tr class="@(isOverdue ? "table-warning" : "")">
                                <td>
                                    <a asp-action="Details" asp-route-id="@bill.BillId" class="text-decoration-none fw-semibold">
                                        @bill.BillNumber
                                    </a>
                                </td>
                                <td class="text-muted small">@bill.OrderNumber ?? "—"</td>
                                <td>@bill.ContactName</td>
                                <td><span class="badge bg-light text-dark">@bill.CategoryName</span></td>
                                <td>@bill.BilledAt.ToString("dd MMM yyyy")</td>
                                <td class="@(isOverdue ? "text-danger fw-semibold" : "")">
                                    @bill.DueAt.ToString("dd MMM yyyy")
                                    @if (isOverdue) { <i class="bi bi-exclamation-triangle-fill text-warning ms-1"></i> }
                                </td>
                                <td class="fw-semibold text-end">@bill.CurrencySymbol@bill.Amount.ToString("N2")</td>
                                <td class="text-success text-end">@bill.CurrencySymbol@bill.AmountPaid.ToString("N2")</td>
                                <td class="text-end @(bill.AmountDue > 0 ? "text-danger" : "text-success")">
                                    @bill.CurrencySymbol@bill.AmountDue.ToString("N2")
                                </td>
                                <td>
                                    @{
                                        var (badge, color) = bill.Status switch
                                        {
                                            DocumentStatus.Draft => ("Draft", "secondary"),
                                            DocumentStatus.Sent => ("Sent", "primary"),
                                            DocumentStatus.Partial => ("Partial", "info"),
                                            DocumentStatus.Paid => ("Paid", "success"),
                                            DocumentStatus.Cancelled => ("Cancelled", "danger"),
                                            _ => ("Unknown", "dark")
                                        };
                                    }
                                    <span class="badge bg-@color">@badge</span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@bill.BillId" class="btn btn-outline-primary" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (bill.Status == DocumentStatus.Draft || User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@bill.BillId" class="btn btn-outline-secondary" title="Edit">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                        }
                                        <a asp-action="Print" asp-route-id="@bill.BillId" class="btn btn-outline-info" title="Print" target="_blank">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                        @if (bill.Status == DocumentStatus.Draft)
                                        {
                                            <form asp-action="Delete" asp-route-id="@bill.BillId" method="post" style="display:inline;"
                                                  onsubmit="return confirm('Delete bill @bill.BillNumber?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>