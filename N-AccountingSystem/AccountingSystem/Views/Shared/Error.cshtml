@model AccountingSystem.Models.ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var icon = Model.StatusCode switch
    {
        404 => "bi-search",
        403 => "bi-shield-lock-fill",
        _ => "bi-exclamation-triangle-fill"
    };

    var color = Model.StatusCode switch
    {
        403 => "warning",
        404 => "info",
        _ => "danger"
    };
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="text-center">
        <i class="bi @icon text-@color" style="font-size: 5rem;"></i>
        <h1 class="display-4 fw-bold mt-3">@Model.StatusCode</h1>
        <h3 class="text-muted mb-3">@Model.Title</h3>
        <p class="text-muted mb-4" style="max-width: 500px; margin: 0 auto;">@Model.Message</p>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted small mb-4">
                Request ID: <code>@Model.RequestId</code>
            </p>
        }

        <div class="d-flex justify-content-center gap-2">
            <a href="/" class="btn btn-primary">
                <i class="bi bi-house-door me-1"></i> Go Home
            </a>
            <button onclick="history.back()" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Go Back
            </button>
        </div>
    </div>
</div>
