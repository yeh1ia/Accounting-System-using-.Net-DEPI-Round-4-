@model IEnumerable<Accounting.Data.ViewModels.Administration.UserListItem>

@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-people-fill"></i> Users Management</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> New User
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="bi bi-people" style="font-size:2rem;"></i>
                                <p class="mb-0">No users found.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <td><div class="fw-semibold">@user.FullName</div></td>
                                <td><span class="text-muted">@user.Email</span></td>
                                <td>@user.PhoneNumber ?? "—"</td>
                                <td>
                                    @if (user.Roles.Any())
                                    {
                                        @foreach (var role in user.Roles)
                                        {
                                            <span class="badge bg-info me-1">@role</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No Role</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsLocked)
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-lock-fill"></i> Locked</span>
                                    }
                                    else if (user.AccessFailedCount >= 3)
                                    {
                                        <span class="badge bg-warning">Failed Login</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success"><i class="bi bi-unlock-fill"></i> Active</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        @if (User.Identity?.Name != user.Email)
                                        {
                                            <form asp-action="ToggleLock" asp-route-id="@user.Id" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-warning" title="@(user.IsLocked ? "Unlock" : "Lock")">
                                                    <i class="bi @(user.IsLocked ? "bi-unlock-fill" : "bi-lock-fill")"></i>
                                                </button>
                                            </form>
                                            <form asp-action="Delete" asp-route-id="@user.Id" method="post" style="display:inline;"
                                                  onsubmit="return confirm('Delete user @user.FullName?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>