@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@model DashboardStats

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var user = await UserManager.GetUserAsync(User);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">
            <i class="bi bi-grid-1x2-fill text-primary"></i> Dashboard
        </h2>
        <p class="text-muted mb-0">Welcome back, <strong>@user?.FullName</strong>!</p>
    </div>
    <div>
        <span class="badge bg-primary fs-6">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</span>
    </div>
</div>

@* Quick Stats *@
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #0d6efd !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted small mb-1">Total Bills</p>
                        <h3 class="mb-0">@Model.TotalBills.ToString("N0")</h3>
                        <small class="text-muted">@Model.TotalBillsAmount.ToString("N2") total amount</small>
                    </div>
                    <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-file-earmark-text-fill text-primary fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #198754 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted small mb-1">Accounts</p>
                        <h3 class="mb-0">@Model.TotalAccounts.ToString("N0")</h3>
                        <small class="text-muted">Chart of accounts</small>
                    </div>
                    <div class="bg-success bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-bookmark-fill text-success fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #ffc107 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted small mb-1">Pending Approvals</p>
                        <h3 class="mb-0">@Model.PendingApprovals.ToString("N0")</h3>
                        <small class="text-muted">Draft bills waiting</small>
                    </div>
                    <div class="bg-warning bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-hourglass-split text-warning fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #dc3545 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted small mb-1">Users</p>
                        <h3 class="mb-0">@Model.TotalUsers.ToString("N0")</h3>
                        <small class="text-muted">Registered users</small>
                    </div>
                    <div class="bg-danger bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-people-fill text-danger fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Financial Summary *@
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #0d6efd !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted small mb-1">Total Billed</p>
                        <h3 class="mb-0">@Model.TotalBillsAmount.ToString("N2")</h3>
                        <small class="text-muted">All bills total</small>
                    </div>
                    <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-currency-dollar text-primary fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #198754 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted small mb-1">Total Paid</p>
                        <h3 class="mb-0">@Model.TotalPaidAmount.ToString("N2")</h3>
                        <small class="text-muted">Collected amount</small>
                    </div>
                    <div class="bg-success bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-check-circle-fill text-success fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #dc3545 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted small mb-1">Total Due</p>
                        <h3 class="mb-0">@Model.TotalDueAmount.ToString("N2")</h3>
                        <small class="text-muted">Outstanding amount</small>
                    </div>
                    <div class="bg-danger bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-clock-fill text-danger fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Bill Status Breakdown *@
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <h5 class="mb-0">@Model.DraftBills.ToString("N0")</h5>
                <small class="text-muted">Draft Bills</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <h5 class="mb-0">@Model.SentBills.ToString("N0")</h5>
                <small class="text-muted">Sent Bills</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <h5 class="mb-0">@Model.PaidBills.ToString("N0")</h5>
                <small class="text-muted">Paid Bills</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center">
                <h5 class="mb-0 @(Model.OverdueBills > 0 ? "text-danger" : "")">@Model.OverdueBills.ToString("N0")</h5>
                <small class="text-muted">Overdue Bills</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    @* Quick Actions *@
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-lightning me-2 text-warning"></i>Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <a asp-controller="Bills" asp-action="Create" class="btn btn-outline-primary w-100 py-3">
                            <i class="bi bi-file-earmark-plus fs-3 d-block mb-2"></i>
                            New Bill
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a asp-controller="Bills" asp-action="Index" class="btn btn-outline-secondary w-100 py-3">
                            <i class="bi bi-list-ul fs-3 d-block mb-2"></i>
                            Bills List
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a asp-controller="Bills" asp-action="Approvals" class="btn btn-outline-warning w-100 py-3">
                            <i class="bi bi-check-circle fs-3 d-block mb-2"></i>
                            Approvals
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a asp-controller="Accounts" asp-action="Create" class="btn btn-outline-success w-100 py-3">
                            <i class="bi bi-folder-plus fs-3 d-block mb-2"></i>
                            New Account
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a asp-controller="Accounts" asp-action="Index" class="btn btn-outline-info w-100 py-3">
                            <i class="bi bi-bookmark fs-3 d-block mb-2"></i>
                            Chart of Accounts
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a asp-controller="Users" asp-action="Index" class="btn btn-outline-danger w-100 py-3">
                            <i class="bi bi-people fs-3 d-block mb-2"></i>
                            Users
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Sidebar *@
    <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-link-45deg me-2 text-primary"></i>Quick Links</h5>
            </div>
            <div class="list-group list-group-flush">
                <a asp-controller="Bills" asp-action="Index" class="list-group-item list-group-item-action">
                    <i class="bi bi-file-earmark-text me-2"></i> All Bills
                </a>
                <a asp-controller="Bills" asp-action="Approvals" class="list-group-item list-group-item-action">
                    <i class="bi bi-check-circle me-2 text-warning"></i> Pending Approvals
                </a>
                <a asp-controller="Accounts" asp-action="Index" class="list-group-item list-group-item-action">
                    <i class="bi bi-bookmark me-2 text-success"></i> Chart of Accounts
                </a>
                <a asp-controller="Users" asp-action="Index" class="list-group-item list-group-item-action">
                    <i class="bi bi-people me-2 text-danger"></i> User Management
                </a>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-person-circle me-2 text-secondary"></i>Your Account</h5>
            </div>
            <div class="card-body text-center">
                <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                     style="width:64px;height:64px;">
                    <i class="bi bi-person-fill text-primary fs-3"></i>
                </div>
                <h5 class="mb-1">@user?.FullName</h5>
                <p class="text-muted small mb-3">@User.Identity?.Name</p>
                <div class="d-grid gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-house me-1"></i> Home
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                            <i class="bi bi-box-arrow-right me-1"></i> Logout
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>