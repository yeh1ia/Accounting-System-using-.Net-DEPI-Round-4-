@using Accounting.Data.Domain

@model Accounting.Data.ViewModels.Purchases.BillDetailViewModel

@{
    ViewData["Title"] = $"Bill - {Model.BillNumber}";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var statusColor = Model.Status switch
    {
        DocumentStatus.Draft => "secondary",
        DocumentStatus.Sent => "primary",
        DocumentStatus.Partial => "info",
        DocumentStatus.Paid => "success",
        DocumentStatus.Cancelled => "danger",
        _ => "dark"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="mb-0">@Model.BillNumber</h2>
            <small class="text-muted">@Model.BilledAt.ToString("dd MMMM yyyy")</small>
        </div>
        <span class="badge bg-@statusColor fs-6">@Model.Status</span>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status == DocumentStatus.Draft || User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-route-id="@Model.BillId" class="btn btn-secondary">
                <i class="bi bi-pencil-square"></i> Edit
            </a>
        }
        <a asp-action="Print" asp-route-id="@Model.BillId" class="btn btn-outline-info" target="_blank">
            <i class="bi bi-printer"></i> Print
        </a>
        @if (Model.Status == DocumentStatus.Draft)
        {
            <form asp-action="ApproveBill" asp-route-id="@Model.BillId" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle"></i> Approve
                </button>
            </form>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white">
                <h5 class="mb-0">Bill Details</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p class="mb-1 text-muted small">Vendor</p>
                        <p class="fw-semibold mb-3">@Model.ContactName</p>
                        @if (!string.IsNullOrEmpty(Model.ContactEmail))
                        {
                            <p class="mb-1 small"><i class="bi bi-envelope me-2"></i>@Model.ContactEmail</p>
                        }
                        @if (!string.IsNullOrEmpty(Model.ContactPhone))
                        {
                            <p class="mb-1 small"><i class="bi bi-telephone me-2"></i>@Model.ContactPhone</p>
                        }
                        @if (!string.IsNullOrEmpty(Model.ContactAddress))
                        {
                            <p class="mb-1 small"><i class="bi bi-geo-alt me-2"></i>@Model.ContactAddress</p>
                        }
                    </div>
                    <div class="col-md-3">
                        <p class="mb-1 text-muted small">Category</p>
                        <p class="fw-semibold">@Model.CategoryName</p>
                        <p class="mb-1 text-muted small">Order #</p>
                        <p>@Model.OrderNumber ?? "—"</p>
                    </div>
                    <div class="col-md-3 text-end">
                        <p class="mb-1 text-muted small">Due Date</p>
                        <p class="fw-semibold @(Model.DueAt < DateTime.Today && Model.Status != DocumentStatus.Paid ? "text-danger" : "")">
                            @Model.DueAt.ToString("dd MMM yyyy")
                        </p>
                        <p class="mb-1 text-muted small">Currency</p>
                        <p>@Model.CurrencyName (@Model.CurrencySymbol)</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white">
                <h5 class="mb-0">Line Items</h5>
            </div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Description</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Price</th>
                            <th class="text-end">Discount</th>
                            <th class="text-end">Total</th>
                            <th>Account</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Description</td>
                                <td class="text-end">@item.Quantity.ToString("N2")</td>
                                <td class="text-end">@Model.CurrencySymbol@item.Price.ToString("N2")</td>
                                <td class="text-end">
                                    @(item.DiscountType == DiscountType.Percent
                                        ? $"{item.DiscountRate}%"
                                        : $"{Model.CurrencySymbol}{item.DiscountRate}")
                                </td>
                                <td class="text-end fw-semibold">@Model.CurrencySymbol@item.Total.ToString("N2")</td>
                                <td><span class="badge bg-light text-dark">@item.AccountName</span></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="4" class="text-end fw-bold">Total:</td>
                            <td class="text-end fw-bold fs-5">@Model.CurrencySymbol@Model.Amount.ToString("N2")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        @if (Model.Payments.Any())
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white"><h5 class="mb-0">Payments</h5></div>
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead class="table-light">
                            <tr><th>Date</th><th class="text-end">Amount</th><th>Notes</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Payments)
                            {
                                <tr>
                                    <td>@p.PaymentDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-end text-success fw-semibold">@Model.CurrencySymbol@p.Amount.ToString("N2")</td>
                                    <td>@p.Notes ?? "—"</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @if (Model.StatusHistory.Any())
        {
            <div class="card shadow-sm">
                <div class="card-header bg-white"><h5 class="mb-0">Status History</h5></div>
                <div class="card-body">
                    @foreach (var log in Model.StatusHistory)
                    {
                        <div class="d-flex align-items-start mb-2">
                            <div class="me-3">
                                <div class="bg-light rounded-circle p-2 text-center" style="width:32px;height:32px;">
                                    <i class="bi bi-circle-fill text-primary small"></i>
                                </div>
                            </div>
                            <div>
                                <span class="badge bg-primary me-1">@log.Status</span>
                                <span class="small text-muted">@log.CreatedAt.ToString("dd MMM yyyy HH:mm")</span>
                                @if (!string.IsNullOrEmpty(log.Description))
                                {
                                    <p class="mb-0 small">@log.Description</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white"><h5 class="mb-0">Summary</h5></div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr><td>Total Amount</td><td class="text-end fw-bold">@Model.CurrencySymbol@Model.Amount.ToString("N2")</td></tr>
                    <tr><td>Amount Paid</td><td class="text-end text-success">@Model.CurrencySymbol@Model.AmountPaid.ToString("N2")</td></tr>
                    <tr class="border-top">
                        <td class="fw-bold">Amount Due</td>
                        <td class="text-end @(Model.AmountDue > 0 ? "text-danger fs-5 fw-bold" : "text-success")">
                            @Model.CurrencySymbol@Model.AmountDue.ToString("N2")
                        </td>
                    </tr>
                </table>
            </div>
        </div>

        @if (Model.Status != DocumentStatus.Paid && Model.Status != DocumentStatus.Cancelled && Model.AmountDue > 0)
        {
            <div class="card shadow-sm mb-3 border-success">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-cash-coin me-2"></i>Record Payment</h5>
                </div>
                <div class="card-body">
                    <form asp-action="RecordPayment" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="billId" value="@Model.BillId" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Amount</label>
                            <div class="input-group">
                                <span class="input-group-text">@Model.CurrencySymbol</span>
                                <input type="number" name="amount" class="form-control" step="0.01" min="0.01"
                                       max="@Model.AmountDue" value="@Model.AmountDue" required />
                            </div>
                            <small class="text-muted">Due: @Model.CurrencySymbol@Model.AmountDue.ToString("N2")</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Payment Date</label>
                            <input type="date" name="paymentDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small">Notes</label>
                            <input type="text" name="notes" class="form-control" placeholder="Optional" />
                        </div>
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-check-circle me-1"></i> Record Payment
                        </button>
                    </form>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white"><h5 class="mb-0">Notes</h5></div>
                <div class="card-body"><p class="mb-0 text-muted">@Model.Notes</p></div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Footer))
        {
            <div class="card shadow-sm">
                <div class="card-header bg-white"><h5 class="mb-0">Footer</h5></div>
                <div class="card-body"><p class="mb-0 text-muted small">@Model.Footer</p></div>
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-body small text-muted">
                <p class="mb-1"><i class="bi bi-calendar-plus me-2"></i>Created: @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</p>
                <p class="mb-0"><i class="bi bi-calendar-check me-2"></i>Updated: @Model.UpdatedAt.ToString("dd MMM yyyy HH:mm")</p>
            </div>
        </div>
    </div>
</div>